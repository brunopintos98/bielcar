---
import '../styles/multiaviso.css';

/**
 * Contenedor del catálogo. El markup de adentro lo inyecta el plugin en
 * runtime — nosotros solo ponemos la caja y la pisamos con CSS.
 *
 * El <form> replica la estructura del staging, donde el contenedor vive dentro
 * de uno. Probablemente sea herencia de la demo (huele a ASP.NET WebForms),
 * pero el formulario "Contactar ahora" del detalle podría depender de tener un
 * <form> ancestro. Sacarlo después es trivial; descubrir que hacía falta, no.
 *
 * `data-surface` elige el tema de los overrides.
 *
 * El default es **dark**, que es la intención de diseño.
 *
 * Estuvo en "light" una vuelta, y vale saber por qué volvió: el primer intento
 * en oscuro se veía roto —cuerpo de las tarjetas en blanco, labels de filtro y
 * valores de ficha invisibles— y se leyó como "el plugin no se puede oscurecer"
 * (el fallback de §6.3). **El diagnóstico estaba mal.** No era el color: era
 * ESPECIFICIDAD. La hoja del plugin se inyecta en runtime, después de la
 * nuestra, y con especificidad igual gana ella. Los overrides existían y
 * perdían en silencio.
 *
 * Con los selectores prefijados por `.catalog` (una clase más de especificidad,
 * ver multiaviso.css) el empate se rompe y el oscuro funciona.
 *
 * Si alguna vez hay que volver atrás, sigue siendo un atributo — para eso están
 * los tokens `--ma-*`.
 *
 * El slot "header" existe para el carrusel de destacados del Home, que necesita
 * un título propio dentro del mismo contenedor. Las páginas de listado no lo
 * usan: ahí el marco lo pone el <PageHero> de §5.2.
 *
 * Un solo contenedor por página: `containerSelector` del plugin es un selector
 * único, así que no puede haber dos instancias en el mismo documento.
 */
interface Props {
  surface?: 'dark' | 'light';
  /**
   * En qué contexto se usa el catálogo. Gobierna dos cosas que hasta acá eran
   * props separadas y siempre co-variaban:
   *
   * - **El ritmo vertical.** En `'list'` no lleva `padding-block`: el catálogo
   *   es el contenido de la página, arranca pegado al <PageHero>. En
   *   `'carousel'` sí, porque ahí es una banda entre bandas (§4).
   * - **El alto reservado mientras carga.** Ver `--ma-reserve` en
   *   multiaviso.css.
   *
   * El default es `'list'`: son tres páginas contra un solo carrusel, así que
   * el caso especial es el que se declara.
   *
   * Ojo: este `view` NO es el `viewMode` que se le pasa a `MultiavisoScripts`.
   * Tienen que coincidir, pero son componentes distintos —uno va en <head> y el
   * otro en el <body>— y el plugin no expone su modo al DOM.
   */
  view?: 'list' | 'carousel';
}

const { surface = 'dark', view = 'list' } = Astro.props;
---

<div class="catalog" data-surface={surface} data-view={view}>
  <div class="catalog__inner">
    <slot name="header" />
    <form>
      <div id="MultiavisoContainer"></div>
    </form>
  </div>

  {/*
    Chrome de la hoja de filtros en mobile. Es markup NUESTRO y vive FUERA de
    `#MultiavisoContainer` a propósito: el plugin es dueño de todo lo que hay
    adentro y la regla del proyecto es no tocárselo con JS. Acá no se inyecta
    nada en su árbol — se pone un backdrop y dos barras al lado, y el CSS
    (multiaviso.css §7) reposiciona su `#FilterContent` entre las dos.

    Está en TODAS las páginas que usan el catálogo, incluida la home. Ahí no
    molesta: el carrusel no renderiza `#FilterContent`, así que el script nunca
    llega a poner la clase que lo hace visible.
  */}
  <div class="ma-sheet" data-ma-sheet inert>
    <button class="ma-sheet__backdrop" type="button" data-ma-close aria-label="Cerrar filtros"
    ></button>

    {/*
      Superficie opaca de la hoja. Existe porque el fondo NO puede vivir en
      `#FilterContent`: ese es el contenedor que scrollea, y en el rebote de
      iOS su background se pinta junto con el contenido, así que al pasarse del
      final se veía el listado de atrás. Esta caja es fija, no scrollea, y tapa
      exactamente el área de la hoja.
    */}
    <div class="ma-sheet__surface" aria-hidden="true"></div>

    <nav class="ma-sheet__rail" aria-label="Categorías de filtro"></nav>

    <div class="ma-sheet__head">
      <span class="ma-sheet__title">Filtros y orden</span>
      <button class="ma-sheet__close" type="button" data-ma-close aria-label="Cerrar filtros">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </button>
    </div>

    <div class="ma-sheet__foot">
      <button class="ma-sheet__clear" type="button" hidden>Limpiar filtros</button>
      <button class="ma-sheet__apply" type="button">Ver resultados</button>
    </div>
  </div>
</div>

<script>
  /* Sincroniza nuestro chrome con el acordeón del plugin.
   *
   * El plugin sigue siendo el dueño del estado de ABIERTO/CERRADO:
   * `#FiltersTitle` es su trigger y abre `#FilterContent` escribiendo
   * `display: block` INLINE. Acá NO se escribe en su DOM para abrir/cerrar —
   * se OBSERVA, y para cerrar se despacha un click en su propio trigger.
   *
   * Las opciones SÍ se interceptan en captura: cada filtro es un link que
   * recargaría la página, y §8 pide aplicar recién en "Ver resultados".
   * preventDefault no muta markup. El único write al árbol del plugin es
   * `data-ma-pending` (nunca `class`: el observer filtra `style`/`class`).
   */
  const MOBILE = '(max-width: 699px)';
  const IGNORED_PARAMS = new Set(['ma_page', 'ma_carid']);

  const sheet = document.querySelector<HTMLElement>('[data-ma-sheet]');
  const container = document.getElementById('MultiavisoContainer');

  if (sheet && container) {
    const mq = window.matchMedia(MOBILE);
    /* Mismo patrón que `mq`: una instancia viva, se lee `.matches` en el
       momento de scrollear. No hace falta un listener de `change` — a
       diferencia de `mq`, nada necesita reaccionar a que cambie a mitad de
       sesión. */
    const reduceMotionMq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const closeBtn = sheet.querySelector<HTMLButtonElement>('.ma-sheet__close');
    const applyBtn = sheet.querySelector<HTMLButtonElement>('.ma-sheet__apply');
    const clearBtn = sheet.querySelector<HTMLButtonElement>('.ma-sheet__clear');
    const rail = sheet.querySelector<HTMLElement>('.ma-sheet__rail');
    const catalog = container.closest<HTMLElement>('.catalog');
    let open = false;
    let activeCat: number | null = null;
    /* Estado del scroll programático hacia una categoría (click en el riel).
       `scrollTarget` es el `scrollTop` que se le pidió a `#FilterContent`; el
       listener de `scroll` lo compara contra el real para saber cuándo
       "llegó" y devolverle el control al scrollspy. El timeout es solo la red
       de contención si el navegador nunca reporta ese scrollTop exacto
       (redondeo, rebote, o el usuario interrumpe el scroll a mitad). */
    let programmaticScroll = false;
    let scrollTarget = 0;
    let scrollFallback: number | undefined;
    /* Nodo de `#FilterContent` al que ya se le agregó el listener de scroll.
       Evita duplicarlo si `buildRail` corre más de una vez sobre el mismo
       panel — se re-ejecuta en cada apertura de la hoja. */
    let scrollBound: HTMLElement | null = null;
    let spyQueued = false;
    /* Cierre optimista: el observer lee `display !== none` y jQuery deja
       `display: block` durante todo el slideUp. Si esperáramos a `isOpen() ===
       false`, el chrome se iría DESPUÉS de que el panel ya colapsó. Durante
       `closing` se ignora un `isOpen()` true residual. */
    let closing = false;
    let wipeAll = false;
    const selections = new Map<number, Map<string, string> | null>();

    const syncFilterCount = (): void => {
      const n = document.querySelectorAll('#CurrentFilters .current-filter').length;
      catalog?.style.setProperty('--ma-filter-count', n > 0 ? `" (${n})"` : '""');
    };

    const isOpen = (): boolean => {
      if (!mq.matches) return false;
      const panel = document.getElementById('FilterContent');
      return panel !== null && getComputedStyle(panel).display !== 'none';
    };

    const getBlocks = (): HTMLElement[] => {
      const panel = document.getElementById('FilterContent');
      if (!panel) return [];
      return [...panel.querySelectorAll<HTMLElement>(':scope > .filter-block')];
    };

    /* Bloques "categoría": los que tienen `.filter-block-label`. Excluye
       `#Counts` (nth 1), que no tiene label y por eso no es navegable desde
       el riel — pero sigue contando para los índices `nth` de `getBlocks()`,
       que son 1-based y compartidos con `selections`. Única fuente para el
       riel (armado de botones) Y el scrollspy (candidato activo): los dos
       necesitan la misma lista de categorías y el mismo índice. */
    const categoryBlocks = (): { nth: number; block: HTMLElement; label: string }[] =>
      getBlocks()
        .map((block, index) => ({
          nth: index + 1,
          block,
          label: block.querySelector('.filter-block-label')?.textContent?.trim() ?? '',
        }))
        .filter((entry) => entry.label !== '');

    const readMa = (href: string): Map<string, string> => {
      const map = new Map<string, string>();
      for (const [key, value] of new URL(href, location.href).searchParams) {
        if (key.startsWith('ma_') && !IGNORED_PARAMS.has(key)) map.set(key, value);
      }
      return map;
    };

    const mapsEqual = (a: Map<string, string>, b: Map<string, string>): boolean => {
      if (a.size !== b.size) return false;
      for (const [key, value] of a) if (b.get(key) !== value) return false;
      return true;
    };

    const sliceOwned = (map: Map<string, string>, owned: Set<string>): Map<string, string> => {
      const slice = new Map<string, string>();
      for (const key of owned) {
        const value = map.get(key);
        if (value !== undefined) slice.set(key, value);
      }
      return slice;
    };

    const linksIn = (block: Element): HTMLAnchorElement[] => {
      const items = [...block.querySelectorAll<HTMLAnchorElement>('a.filter-block-item')];
      if (items.length > 0) return items;
      return [...block.querySelectorAll<HTMLAnchorElement>('#SortPopupInner a')];
    };

    /* Keys que ESTE bloque controla. Unión de los ma_* de sus links, menos
       los que aparecen en todos (contexto ya aplicado, p.ej. ma_brand en
       Carrocería con Honda puesto). Si unión e intersección coinciden, el
       bloque solo tiene esas keys (Marca = ma_brand). */
    const ownedKeys = (block: Element): Set<string> => {
      const maps = linksIn(block).map((link) => readMa(link.href));
      if (maps.length === 0) return new Set();
      const union = new Set<string>();
      for (const map of maps) for (const key of map.keys()) union.add(key);
      const intersection = new Set<string>();
      for (const key of union) {
        if (maps.every((map) => map.has(key))) intersection.add(key);
      }
      if (intersection.size === union.size) return union;
      const owned = new Set<string>();
      for (const key of union) if (!intersection.has(key)) owned.add(key);
      return owned;
    };

    const baselineMa = (): Map<string, string> => readMa(location.href);

    const compose = (): Map<string, string> => {
      if (wipeAll) return new Map();
      const result = new Map(baselineMa());
      for (const [nth, override] of selections) {
        const block = getBlocks()[nth - 1];
        if (!block) continue;
        const owned = ownedKeys(block);
        for (const key of owned) result.delete(key);
        if (!override) continue;
        for (const [key, value] of override) {
          if (owned.has(key)) result.set(key, value);
        }
      }
      return result;
    };

    const toUrl = (map: Map<string, string>): string => {
      const params = new URLSearchParams();
      for (const [key, value] of map) params.set(key, value);
      const query = params.toString();
      return query ? `${location.pathname}?${query}` : location.pathname;
    };

    const resetPending = (): void => {
      wipeAll = false;
      selections.clear();
      const panel = document.getElementById('FilterContent');
      panel?.querySelectorAll('[data-ma-pending]').forEach((node) => {
        node.removeAttribute('data-ma-pending');
      });
      rail?.querySelectorAll('[data-ma-filled]').forEach((node) => {
        node.removeAttribute('data-ma-filled');
      });
      if (clearBtn) clearBtn.hidden = true;
    };

    const paintPending = (): void => {
      const composed = compose();
      for (const block of getBlocks()) {
        const owned = ownedKeys(block);
        const current = sliceOwned(composed, owned);
        for (const link of linksIn(block)) {
          const tapped = sliceOwned(readMa(link.href), owned);
          link.toggleAttribute('data-ma-pending', mapsEqual(tapped, current) && current.size > 0);
        }
      }
      rail?.querySelectorAll<HTMLButtonElement>('.ma-sheet__rail-item').forEach((btn) => {
        const nth = Number(btn.dataset.maCat);
        const block = getBlocks()[nth - 1];
        if (!block) {
          btn.removeAttribute('data-ma-filled');
          return;
        }
        const filled = sliceOwned(composed, ownedKeys(block)).size > 0;
        btn.toggleAttribute('data-ma-filled', filled);
      });
      if (clearBtn) clearBtn.hidden = wipeAll || (composed.size === 0 && baselineMa().size === 0);
    };

    const selectFilter = (link: HTMLAnchorElement): void => {
      const block = link.closest('.filter-block');
      if (!block) return;
      const nth = getBlocks().indexOf(block as HTMLElement) + 1;
      if (nth === 0) return;
      const owned = ownedKeys(block);
      const tapped = sliceOwned(readMa(link.href), owned);
      const current = sliceOwned(compose(), owned);
      wipeAll = false;
      if (mapsEqual(tapped, current)) {
        if (selections.has(nth)) selections.delete(nth);
        else selections.set(nth, null);
      } else {
        selections.set(nth, tapped);
      }
      paintPending();
    };

    /* Umbral en px antes de considerar "cruzada" la sección siguiente. Sin
       margen, el bloque que arranca justo en el borde superior del panel
       tarda un frame de más en marcarse y el riel parpadea al toque. */
    const SPY_THRESHOLD = 12;

    const activeCategoryForScroll = (panel: HTMLElement): number | null => {
      const cats = categoryBlocks();
      if (cats.length === 0) return null;

      /* Forzar la última categoría al llegar al fondo: si mide poco (p.ej.
         "Transmisión" con dos opciones) su `top` nunca cruza el umbral desde
         arriba y quedaría sin marcar nunca, aunque sea literalmente lo
         último que se ve. */
      if (panel.scrollTop + panel.clientHeight >= panel.scrollHeight - 2) {
        return cats[cats.length - 1].nth;
      }

      let candidate = cats[0].nth;
      for (const { nth, block } of cats) {
        const marginTop = parseFloat(getComputedStyle(block).scrollMarginTop) || 0;
        if (block.offsetTop - marginTop <= panel.scrollTop + SPY_THRESHOLD) candidate = nth;
      }
      return candidate;
    };

    /* Un solo listener de `scroll` en `#FilterContent`, coalescido con rAF —
       mismo criterio que `schedule` para las mutaciones del plugin. Mientras
       dura un scroll programático (click en el riel) se ignora: si no, el
       riel marcaría de paso todas las categorías intermedias y se leería
       como parpadeo en vez de salto directo a la elegida. */
    const onPanelScroll = (): void => {
      if (!mq.matches || !open || spyQueued) return;
      spyQueued = true;
      requestAnimationFrame(() => {
        spyQueued = false;
        const panel = document.getElementById('FilterContent');
        if (!panel) return;

        if (programmaticScroll) {
          if (Math.abs(panel.scrollTop - scrollTarget) < 2) {
            programmaticScroll = false;
            window.clearTimeout(scrollFallback);
          } else {
            return;
          }
        }

        const nth = activeCategoryForScroll(panel);
        if (nth !== null && nth !== activeCat) paintCategory(nth);
      });
    };

    /* Solo pinta: `aria-pressed` en el riel y, si el ítem activo quedó fuera
       de vista (el riel desbordó y scrollea, caso raro con 8 categorías),
       `scrollIntoView({ block: 'nearest' })` lo trae de vuelta sin mover nada
       si ya estaba visible. NO scrollea `#FilterContent` — eso es
       `scrollToCategory`, y separarlas es lo que permite que el scrollspy
       pinte sin generar un scroll en loop. */
    const paintCategory = (nth: number): void => {
      activeCat = nth;
      rail?.querySelectorAll<HTMLButtonElement>('.ma-sheet__rail-item').forEach((btn) => {
        const isActive = btn.dataset.maCat === String(nth);
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        if (isActive) btn.scrollIntoView({ block: 'nearest' });
      });
    };

    /* Cuánto tarda como máximo en asentarse el `scrollTo` suave antes de que
       el scrollspy retome el control igual, llegue o no exactamente al
       `scrollTarget` calculado (ver el comentario de `programmaticScroll`
       más arriba). Más que `--dur-drawer` (400ms): la distancia a scrollear
       acá no tiene un tope fijo como el slide de la hoja. */
    const SCROLL_SETTLE_FALLBACK_MS = 500;

    /* Scrollea `#FilterContent` — el contenedor que de verdad scrollea, NO
       el viewport — hasta el bloque `nth`. El offset resta
       `scroll-margin-top` (CSS, multiaviso.css) en vez de un número
       duplicado acá: una sola fuente de verdad para "cuánto aire" queda
       arriba del bloque. */
    const scrollToCategory = (nth: number): void => {
      const panel = document.getElementById('FilterContent');
      const block = getBlocks()[nth - 1];
      if (!panel || !block) return;

      const marginTop = parseFloat(getComputedStyle(block).scrollMarginTop) || 0;
      const max = panel.scrollHeight - panel.clientHeight;
      scrollTarget = Math.min(Math.max(block.offsetTop - marginTop, 0), max);

      programmaticScroll = true;
      window.clearTimeout(scrollFallback);
      scrollFallback = window.setTimeout(() => {
        programmaticScroll = false;
      }, SCROLL_SETTLE_FALLBACK_MS);

      panel.scrollTo({ top: scrollTarget, behavior: reduceMotionMq.matches ? 'auto' : 'smooth' });
    };

    /* El click del riel hace las dos cosas; el scrollspy (`onPanelScroll`)
       solo pinta, nunca llama a esto — si lo hiciera, cada scroll disparado
       por el propio scrollspy relanzaría un `scrollTo`, y con eso un loop. */
    const selectCategory = (nth: number): void => {
      paintCategory(nth);
      scrollToCategory(nth);
    };

    const buildRail = (): void => {
      if (!mq.matches || !rail) {
        rail && (rail.innerHTML = '');
        activeCat = null;
        return;
      }

      const panel = document.getElementById('FilterContent');
      if (panel) {
        /* Arranca arriba: jQuery no resetea el scroll al reabrir (solo
           togglea `display`), así que sin esto una segunda apertura heredaría
           la posición de scroll de la primera. */
        panel.scrollTop = 0;
        if (scrollBound !== panel) {
          panel.addEventListener('scroll', onPanelScroll, { passive: true });
          scrollBound = panel;
        }
      }

      const entries = categoryBlocks();
      if (entries.length === 0) {
        rail.innerHTML = '';
        return;
      }

      const signature = entries.map(({ nth, label }) => `${nth}:${label}`).join('|');
      if (rail.dataset.sig !== signature) {
        rail.dataset.sig = signature;
        rail.innerHTML = '';
        for (const { nth, label } of entries) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'ma-sheet__rail-item';
          btn.dataset.maCat = String(nth);
          btn.textContent = label;
          btn.addEventListener('click', () => selectCategory(nth));
          rail.appendChild(btn);
        }
      }

      /* Primera categoría siempre, no la última activa antes de cerrar: el
         panel ya se reseteó a scrollTop 0 arriba, y el riel tiene que leer
         igual. */
      paintCategory(entries[0].nth);
      paintPending();
    };

    const apply = (): void => {
      const next = isOpen();
      if (closing) {
        if (!next) closing = false;
        return;
      }
      if (next === open) return;
      open = next;

      document.documentElement.classList.toggle('ma-filters-open', open);
      sheet.toggleAttribute('inert', !open);
      /* Mismo lock de scroll que el drawer del Header. No se usa `inert` en
         los hermanos como allá: ahí los hermanos del drawer son hijos de
         <body>, acá el panel está enterrado en el árbol del plugin y marcar
         hermanos inertaría el propio contenido de la hoja. */
      document.body.style.overflow = open ? 'hidden' : '';

      if (open) {
        buildRail();
        closeBtn?.focus();
      } else {
        resetPending();
        /* Apagar cualquier scroll programático/scrollspy en vuelo: si el
           cierre llega por este camino (p.ej. el viewport cruza a desktop
           con `mq` a mitad de un scroll suave) y no por `close()`, que no
           quede el flag prendido esperando un `scrollTop` que ya no va a
           llegar. */
        programmaticScroll = false;
        window.clearTimeout(scrollFallback);
      }
    };

    /* El plugin anima el colapso con jQuery, o sea decenas de mutaciones de
       `style` por segundo mientras dura. Un frame de coalescing alcanza. */
    let queued = false;
    const schedule = (): void => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        apply();
        syncFilterCount();
      });
    };

    /* Un solo observer sobre el contenedor cubre las dos cosas que importan:
       la inyección del markup en runtime (`childList`) y los toggles
       posteriores (`attributes`). `#FilterContent` no existe todavía cuando
       este script corre. */
    new MutationObserver(schedule).observe(container, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['style', 'class'],
    });

    mq.addEventListener('change', schedule);

    const close = (): void => {
      if (!open || closing) return;
      closing = true;
      open = false;
      resetPending();
      programmaticScroll = false;
      window.clearTimeout(scrollFallback);
      document.documentElement.classList.remove('ma-filters-open');
      sheet.setAttribute('inert', '');
      document.body.style.overflow = '';
      document.getElementById('FiltersTitle')?.click();
    };

    const commit = (): void => {
      const next = compose();
      if (mapsEqual(next, baselineMa())) {
        close();
        return;
      }
      location.assign(toUrl(next));
    };

    sheet.querySelectorAll<HTMLElement>('[data-ma-close]').forEach((el) => {
      el.addEventListener('click', close);
    });
    applyBtn?.addEventListener('click', commit);
    clearBtn?.addEventListener('click', () => {
      wipeAll = true;
      selections.clear();
      paintPending();
    });

    container.addEventListener(
      'click',
      (event) => {
        if (!mq.matches || !open) return;
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest('a');
        if (!link?.closest('#FilterContent')) return;
        if (
          !link.classList.contains('filter-block-item') &&
          !link.closest('#SortPopupInner')
        ) {
          return;
        }
        event.preventDefault();
        event.stopPropagation();
        selectFilter(link);
      },
      true,
    );

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && open) close();
    });

    schedule();
  }
</script>

