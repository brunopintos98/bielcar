---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { PHOTOS } from '../data/site';

/**
 * Hero del Home — §5.2.
 *
 * A diferencia del hero de página interna (PageHero), este SÍ lleva imagen
 * full-bleed, con el h1 sobre el tercio inferior y el degradado
 * `linear-gradient(to top, rgba(0,0,0,.75), transparent 60%)` que asegura
 * legibilidad. Ese degradado está puesto siempre, tenga foto o no, para que el
 * día que llegue la foto no haya que retocar nada.
 *
 * ─── La foto ───────────────────────────────────────────────────────────────
 * Fachada real de La Paz 2028 (`PHOTOS.homeHero`). Estuvo en null mucho tiempo
 * y el hero renderizaba un <Placeholder>: la regla era no poner una foto de
 * stock, porque una automotora mostrando un local que no es el suyo es
 * contenido falso, no un provisorio. Sigue valiendo si algún día se cambia.
 *
 * ─── Por qué un solo CTA y por qué es fantasma ──────────────────────────────
 * §5.3 dice que el color de acción es el verde de WhatsApp y que no hay sólido
 * de marca. Un CTA de WhatsApp acá renderizaría un tercer <Placeholder> en la
 * primera pantalla (ya hay uno en el header por el logo y otro en el FAB). El
 * empujón natural del hero de una automotora es al catálogo, así que va un
 * fantasma a /vehiculos y la conversión se resuelve más abajo, en el CTA de
 * service y en el FAB.
 */
const media = PHOTOS.homeHero;
---

<section class="hero">
  {/* Pasó de `background-image` a <Image>: un background no puede tener
      srcset, así que un teléfono bajaba la versión grande igual. Acá es la
      imagen LCP del sitio entero, o sea donde más pesa. */}
  <Image
    class="hero__media"
    src={media.src}
    alt={media.alt}
    widths={[640, 960, 1280, 1920]}
    sizes="100vw"
    format="webp"
    quality={72}
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />

  <div class="hero__content">
    <div class="container">
      <h1 class="h1">Vehículos 0km y usados en Montevideo.</h1>
      <p class="lede hero__lede">
        Somos servicio oficial y tomamos su usado en parte de pago.
      </p>
      <div class="hero__cta">
        <Button variant="ghost-dark" href="/vehiculos">Ver vehículos</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    /* Alto de viewport menos el header sticky, con un piso para que en pantallas
       muy bajas el h1 no quede aplastado contra el nav. NO se usa el nombre
       --screen-height: el plugin ya define esa variable en :root (§6.2).
       La primera declaración es el fallback: si el browser no entiende `svh`,
       el `max()` entero se invalida y sin ella el hero se quedaría sin alto. */
    min-height: 560px;
    min-height: max(560px, calc(100svh - var(--header-h)));
    background: var(--surface-dark);
    overflow: hidden;
    /* Sin radio — enmienda de DESIGN.md §1/§4: el hero es full-bleed a 100vw,
       así que el radio solo se veía en las dos esquinas inferiores (las de
       arriba quedan contra el header sticky). `overflow: hidden` se queda
       igual: sigue haciendo falta para clipear el ken-burns de `.hero__media`
       (`scale(1.06)` al cargar), que si no se recortaría por fuera del hero. */
  }

  .hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    /* Mismo criterio que PhotoHero: la foto se baja de brillo para que el h1 y
       la bajada se lean, en vez de subir el degradado a negro pleno. Un poco
       más suave que en las páginas internas (0.7 contra 0.6) porque acá el
       hero es la portada y la foto tiene que respirar. */
    filter: brightness(0.7);
    /* Ken-burns leve, on-load — DESIGN.md §4. Transform en la propia imagen,
       no en `.hero` (que es el que clipea con `overflow: hidden`): así el
       recorte se mantiene fijo y lo único que se mueve es el encuadre de
       adentro. No usa `will-change`: es una animación de una sola vez, no
       hace falta prometerle nada al compositor. */
    animation: hero-kenburns 1.2s var(--ease) both;
  }

  @keyframes hero-kenburns {
    from { transform: scale(1.06); }
    to   { transform: scale(1); }
  }

  /* On-load, NO on-scroll: el hero está sobre el fold y gatearlo por el
     observer castigaría el LCP (§4). Stagger h1 → lede → botón, 80ms de
     paso, 12px de shift — la imagen NO se anima en opacidad, es la imagen
     LCP de todo el sitio. */
  .hero h1 {
    animation: hero-in var(--dur-reveal) var(--ease) both;
  }

  @keyframes hero-in {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }


  /* §5.2 — el degradado va siempre, con foto o sin ella. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent 60%);
    pointer-events: none;
  }


  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: var(--space-16);
  }

  .hero__lede {
    margin-top: var(--space-6);
    animation: hero-in var(--dur-reveal) var(--ease) 80ms both;
  }

  .hero__cta {
    margin-top: var(--space-8);
    animation: hero-in var(--dur-reveal) var(--ease) 160ms both;
  }

  @media (max-width: 899px) {
    .hero {
      min-height: 440px;
      min-height: max(440px, calc(100svh - var(--header-h)));
    }

    .hero__content {
      padding-block: var(--space-12);
    }
  }
</style>
