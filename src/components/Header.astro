---
import { cleanPath, LOGO, site, ROUTES } from '../data/site';

/**
 * Header sticky — §5.1.
 *
 * En premiumcars el nav está partido en dos grupos; acá va uno solo alineado a
 * la derecha porque hay menos items.
 *
 * El logo ya no es el wordmark tipográfico provisorio del scaffold: se usa la
 * variante `onDark` derivada del PNG que mandó Sebastián (ver LOGO en site.ts).
 * Sigue siendo un bitmap de 254px de ancho — a 32px de alto da ~2.2x de
 * densidad, que alcanza. El vector sigue pedido para cuando haya que escalarlo.
 *
 * Mobile: hamburguesa de dos barras (no el glifo Lucide de tres, que no se
 * puede morphar). El mismo botón abre y cierra; las barras rotan a cruz. El
 * drawer entra desde la derecha. El header se queda encima y no se marca
 * `inert` — si se inertara, el botón dejaría de responder.
 */
/**
 * Los ítems salen de ROUTES (site.ts), que es también de donde sale el
 * sitemap. Estaban duplicados y esa es la forma clásica de que una página
 * nueva entre al nav —porque se ve— y quede fuera del XML durante meses.
 *
 * '/' está en ROUTES con `nav: false`: al Home se entra por el logo.
 */
const nav = ROUTES.filter((r) => r.nav);

const path = cleanPath(Astro.url.pathname);
---

<header class="header">
  <div class="header__inner">
    <a class="logo" href="/" aria-label={`${site.name} — Inicio`}>
      <img
        class="logo__img"
        src={LOGO.onDark}
        alt={site.name}
        width={LOGO.width}
        height={LOGO.height}
      />
    </a>

    <nav class="nav" aria-label="Navegación principal">
      <ul class="nav__list">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.path}
                class:list={['nav__link', { 'nav__link--active': path === item.path }]}
                aria-current={path === item.path ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="burger" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="drawer">
      <span class="burger__icon" aria-hidden="true">
        <span class="burger__bar"></span>
        <span class="burger__bar"></span>
      </span>
    </button>
  </div>
</header>

<div class="drawer" id="drawer" hidden inert>
  <nav aria-label="Navegación principal (móvil)">
    <ul class="drawer__list">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.path}
              class:list={['drawer__link', { 'drawer__link--active': path === item.path }]}
              aria-current={path === item.path ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    height: var(--header-h);
    background: color-mix(in srgb, var(--surface-dark-raised) 85%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule-on-dark);
    /* Microinteracción, no reveal: se condensa al pasar ~80px de scroll (ver
       el script de más abajo). `height` y `border-bottom-color` nada más —
       ningún `transform` acá, esto SÍ es ancestro de todo lo demás del sitio
       pero nunca de `#MultiavisoWrapper` (Header y `<main>` son hermanos en
       Base.astro), así que no hay riesgo de containing block para la hoja
       de filtros; igual se evita `transform` por disciplina. */
    transition:
      height var(--dur) var(--ease),
      border-bottom-color var(--dur) var(--ease);
  }

  /* 72px → 60px en desktop (en mobile `--header-h` ya es 60px, así que acá
     no cambia nada visible — el breakpoint no hace falta). */
  .header--condensed {
    height: 60px;
    border-bottom-color: var(--rule-strong);
  }

  /* Encima del drawer (600) solo mientras el menú está abierto. Si subiera
     siempre, taparía la hoja de filtros (550), que §6 asume cubre el header. */
  .header--menu-open {
    z-index: calc(var(--z-drawer) + 1);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--text-on-dark);
    flex-shrink: 0;
  }

  /* El alto manda y el ancho sale del aspecto; los atributos width/height del
     <img> están para reservar el espacio y evitar el salto de layout. */
  .logo__img {
    display: block;
    height: 32px;
    width: auto;
  }

  .nav {
    margin-left: auto;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    font-size: var(--fs-body-sm);
    color: var(--text-on-dark-muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .nav__link:hover {
    color: var(--text-on-dark);
  }

  .nav__link--active {
    color: var(--brand-bright);
  }

  .burger {
    display: none;
    margin-left: auto;
    padding: var(--space-2);
    background: none;
    border: 0;
    color: var(--text-on-dark);
    cursor: pointer;
    flex-shrink: 0;
    transition: transform var(--dur) var(--ease);
  }

  .burger:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .burger:active {
      transform: none;
    }
  }

  /* Dos barras desiguales, ancladas a la derecha. Caja 22×6: trazo 2px y
     hueco 2px (el hueco es un trazo). Abajo = 14px ≈ 64% de la de arriba. */
  .burger__icon {
    position: relative;
    display: block;
    width: 22px;
    height: 6px;
  }

  .burger__bar {
    position: absolute;
    right: 0;
    height: 2px;
    background: currentColor;
    transform-origin: center;
    transition:
      transform var(--dur) var(--ease),
      width var(--dur) var(--ease);
  }

  .burger__bar:first-child {
    top: 0;
    width: 22px;
  }

  .burger__bar:last-child {
    bottom: 0;
    width: 14px;
  }

  /* Centros: 1px y 5px. Punto medio: 3px. Cada una recorre 2px.
     La de abajo se estira a 22px (crece hacia la izquierda, `right: 0`)
     para que la cruz quede simétrica. */
  .burger[aria-expanded='true'] .burger__bar:first-child {
    transform: translateY(2px) rotate(45deg);
  }

  .burger[aria-expanded='true'] .burger__bar:last-child {
    width: 22px;
    transform: translateY(-2px) rotate(-45deg);
  }

  /* ------------------------------------------------------------- drawer */

  .drawer {
    position: fixed;
    inset: 0;
    z-index: var(--z-drawer);
    background: color-mix(in srgb, var(--surface-dark) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: var(--gutter);
    padding-top: calc(var(--header-h) + var(--space-8));
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform var(--dur-drawer) var(--ease);
  }

  .drawer.is-open {
    transform: translateX(0);
  }

  .drawer[hidden] {
    display: none;
  }

  .drawer__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .drawer__link {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--text-on-dark);
    text-decoration: none;
  }

  .drawer__link--active {
    color: var(--brand-bright);
  }

  @media (max-width: 899px) {
    .nav {
      display: none;
    }

    .burger {
      display: block;
    }

    .logo__img {
      height: 28px;
    }
  }
</style>

<script>
  const drawer = document.getElementById('drawer');
  const header = document.querySelector<HTMLElement>('.header');
  const openBtn = document.querySelector<HTMLButtonElement>('.header .burger');

  let hideTimer: number | undefined;

  function reduceMotion(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  /* El fallback tiene que vivir DESPUÉS de `--dur-drawer`, no de un 300ms
     cableado: si el token sube, un timeout corto tapa el slide a mitad. */
  function drawerHideDelay(): number {
    if (!drawer) return 500;
    const raw = getComputedStyle(drawer).transitionDuration.split(',')[0]?.trim() ?? '';
    const ms = raw.endsWith('ms') ? parseFloat(raw) : parseFloat(raw) * 1000;
    return (Number.isFinite(ms) ? ms : 400) + 80;
  }

  function isOpen(): boolean {
    return openBtn?.getAttribute('aria-expanded') === 'true';
  }

  function setSiblingsInert(open: boolean) {
    Array.from(document.body.children).forEach((el) => {
      if (el === drawer || el === header) return;
      if (open) {
        el.setAttribute('inert', '');
      } else {
        el.removeAttribute('inert');
      }
    });
  }

  function hideDrawer() {
    if (!drawer) return;
    drawer.hidden = true;
    hideTimer = undefined;
  }

  function setOpen(open: boolean, opts: { restoreFocus?: boolean } = {}) {
    if (!drawer || !openBtn || !header) return;

    if (hideTimer !== undefined) {
      window.clearTimeout(hideTimer);
      hideTimer = undefined;
    }

    openBtn.setAttribute('aria-expanded', String(open));
    openBtn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    header.classList.toggle('header--menu-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
    setSiblingsInert(open);

    if (open) {
      drawer.hidden = false;
      drawer.removeAttribute('inert');
      const reveal = () => drawer.classList.add('is-open');
      if (reduceMotion()) {
        reveal();
      } else {
        requestAnimationFrame(() => requestAnimationFrame(reveal));
      }
      drawer.querySelector<HTMLAnchorElement>('a')?.focus();
    } else {
      drawer.classList.remove('is-open');
      drawer.setAttribute('inert', '');
      if (reduceMotion()) {
        hideDrawer();
      } else {
        const onEnd = (e: TransitionEvent) => {
          if (e.propertyName !== 'transform') return;
          drawer.removeEventListener('transitionend', onEnd);
          hideDrawer();
        };
        drawer.addEventListener('transitionend', onEnd);
        hideTimer = window.setTimeout(() => {
          drawer.removeEventListener('transitionend', onEnd);
          hideDrawer();
        }, drawerHideDelay());
      }
      if (opts.restoreFocus !== false) openBtn.focus();
    }
  }

  openBtn?.addEventListener('click', () => setOpen(!isOpen()));

  drawer?.addEventListener('click', (e) => {
    if (e.target === drawer) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) setOpen(false);
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 900 && isOpen()) setOpen(false, { restoreFocus: false });
  });

  /* Condensa el header al pasar ~80px de scroll. Microinteracción aprobada,
     no reveal: no depende de `.js-reveal` ni del observer de `Base.astro`,
     corre siempre. rAF-throttled para no ensuciar el scroll con trabajo de
     layout en cada evento. */
  const CONDENSE_AT = 80;
  let condenseTicking = false;

  function syncCondensed(): void {
    header?.classList.toggle('header--condensed', window.scrollY > CONDENSE_AT);
    condenseTicking = false;
  }

  window.addEventListener(
    'scroll',
    () => {
      if (condenseTicking) return;
      condenseTicking = true;
      requestAnimationFrame(syncCondensed);
    },
    { passive: true }
  );

  /* Estado inicial: si la página carga ya scrolleada (anchor, bfcache),
     el header tiene que arrancar condensado y no esperar al próximo scroll. */
  syncCondensed();
</script>
