---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import Button from '../components/Button.astro';
import { site, SALES_BRANDS, SERVICE_BRANDS, PHOTOS, ABOUT_PARAGRAPHS, list } from '../data/site';

/**
 * /nosotros — composición de §7, sin el bloque de equipo de ventas.
 *
 * ─── El hero lleva foto (bielcar-2), es una desviación de §5.2 ────────────
 * §5.2 pide el hero plano ("Usar exactamente este patrón encima de cada
 * página con Multiaviso") — pero /nosotros no tiene contenedor Multiaviso, así
 * que no aplica el motivo del documento (colisión con la ficha de un vehículo
 * puntual). Mismo caso ya resuelto y en producción en /service: ver el
 * docblock de `PhotoHero.astro`, que ahora lista las dos páginas.
 *
 * `.sobre` se queda en `band--dark` sin pasar a `band--raised`: la corrida
 * hero→sobre→Footer en `#0D0D0D` YA existía idéntica con el hero plano
 * anterior (`PageHero` también era `--surface-dark` sin gradiente) y es el
 * mismo patrón que ya tiene /contacto. El degradado de `PhotoHero` converge a
 * un negro casi opaco sobre foto oscurecida (`brightness(0.6)`) — mismo
 * mecanismo ya verificado en la costura idéntica de /service (PhotoHero →
 * ServiceBrands, también #0D0D0D).
 *
 * ─── El texto institucional ya llegó ───────────────────────────────────────
 * Lo escribió Sebastián y vive en `ABOUT_PARAGRAPHS` (site.ts). Vale la pena
 * dejar anotado por qué esta página estuvo vacía tanto tiempo: "más de X años
 * en plaza", "una empresa familiar", "atención personalizada" son exactamente
 * las frases que suenan verdaderas y que nadie había confirmado. Una página
 * "Nosotros" es donde más tienta inventar, y por eso fue la última en
 * llenarse.
 *
 * La foto del local ya llegó. El resto se afirma desde `site.ts`: dónde está
 * el local, qué marcas vende, de cuáles es servicio oficial y qué hace el
 * taller.
 *
 * ─── El bloque de equipo de ventas se sacó ────────────────────────────────
 * DESIGN.md §7 lo pedía ("Quiénes lo atienden", grilla de vendedores) y acá
 * vivió un tiempo como <Placeholder> esperando nombres, roles y fotos. El
 * cliente decidió NO hacerlo por ahora, así que la sección se eliminó entera
 * en vez de dejar el placeholder puesto: un pendiente visible tiene sentido
 * mientras el contenido está en camino, no cuando la decisión fue no tenerlo.
 * Si se retoma, es volver a agregar una <section class="equipo"> — el resto de
 * la página no la asume desde ningún lado.
 */
const media = PHOTOS.aboutLocal;
const salesBrands = list(SALES_BRANDS);
const serviceBrands = list(SERVICE_BRANDS);
---

<Base
  title="Nosotros"
  description={`Bielcar Automóviles, automotora en ${site.address}. Venta de 0km y usados, servicio oficial ${serviceBrands}, taller multimarca y permuta.`}
>
  <PhotoHero
    image={PHOTOS.aboutHero}
    title="Nosotros"
    lede="Automotora, taller multimarca y servicio oficial, en un mismo lugar."
  />

  <section class="sobre band band--dark">
    <div class="container sobre__split">
      <div class="sobre__media" data-reveal="left">
        {/* El contenedor es 4:3 y el archivo también, así que la foto entra
            ENTERA — `object-fit: cover` no llega a recortar nada.
            `sizes`: media pantalla en desktop, ancho completo apilada. */}
        <Image
          src={media.src}
          alt={media.alt}
          widths={[480, 720, 1080]}
          sizes="(min-width: 900px) 50vw, 100vw"
          format="webp"
          quality={72}
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="sobre__text" data-reveal="right">
        <p class="eyebrow">Bielcar Automóviles</p>
        <h2 class="h2 sobre__title">Estamos en {site.address}.</h2>

        {/* Las dos listas de marcas salen de site.ts. Antes esta bajada seguía
            con "además tenemos taller multimarca, chapa y pintura, y tomamos
            usados en parte de pago", que es exactamente lo que dicen los
            párrafos 2 y 3 del texto de Sebastián acá abajo. Se recortó a lo
            único que el texto institucional NO dice: qué marcas son.

            La frase decía "Vendemos 0km y usados de {salesBrands}", que leído
            de corrido da a entender que los usados también están limitados a
            esas 7 marcas — al vender usados, Bielcar recibe y revende
            cualquier marca (permuta, compra directa), no solo las 7 de las
            que es punto de venta de 0km. Se separa: 0km de las marcas
            oficiales, usados MULTIMARCA aparte. Mismo adjetivo que ya usa
            `ABOUT_PARAGRAPHS` ("vehículo 0km o usado multimarca"). */}
        <p class="lede sobre__lede">
          Vendemos 0km de {salesBrands}, además de usados multimarca, y somos servicio oficial de {serviceBrands}.
        </p>

        <div class="sobre__prose">
          {ABOUT_PARAGRAPHS.map((par) => <p>{par}</p>)}
        </div>

        <div class="sobre__cta">
          <Button variant="ghost-dark" href="/vehiculos">Ver vehículos</Button>
          <Button variant="ghost-dark" href="/contacto">Contacto</Button>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .sobre__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .sobre__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    /* Sistema de radio de imágenes (DESIGN.md §4). */
    border-radius: var(--radius-md);
  }

  .sobre__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  .sobre__title {
    margin-top: var(--space-3);
  }

  .sobre__lede {
    margin-top: var(--space-6);
  }

  .sobre__prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-6);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-on-dark-muted);
    /* Medida de lectura. El texto son ~160 palabras y a todo el ancho de la
       columna los renglones pasan de 90 caracteres. */
    max-width: 62ch;
  }

  .sobre__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-12);
  }

  @media (max-width: 899px) {
    .sobre__split {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
  }
</style>
