{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/lifecycle-marker.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/policy-gate.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "policy",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"${CLAUDE_PROJECT_DIR}/.claude\" && touch \"${CLAUDE_PROJECT_DIR}/.claude/.policy-ran\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git mv:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm audit:*)",
      "Bash(npx:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn tsc:*)",
      "Bash(yarn test:*)",
      "Bash(yarn prettier:*)",
      "Bash(yarn start:*)",
      "Bash(yarn audit:*)",
      "Bash(python3 -m http.server:*)",
      "Bash(vercel:*)"
    ]
  }
}
